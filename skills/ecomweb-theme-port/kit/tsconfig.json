{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true, "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "typeRoots": ["../scripts/node_modules/@types"],
    "paths": { "react": ["../scripts/node_modules/@types/react"], "react/jsx-runtime": ["../scripts/node_modules/@types/react/jsx-runtime"], "next/navigation": ["./next-navigation.d.ts"] }
  },
  "include": ["*.tsx", "*.d.ts"]
}
